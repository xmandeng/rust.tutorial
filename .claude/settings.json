{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Edit",
      "Write",
      "Bash(env)",
      "Bash(echo $GH_TOKEN)",
      "Bash(export GH_TOKEN=\"$GITHUB_ACCESS_TOKEN\")",
      "Bash(xargs:*)",
      "Bash(git push:*)",
      "WebFetch(domain:github.com)",
      "Read(//home/developer/.config/**)",
      "mcp__atlassian__createJiraIssue",
      "mcp__atlassian__editJiraIssue",
      "mcp__atlassian__addOrEditJiraIssueComment",
      "mcp__atlassian__executeWrite",
      "mcp__atlassian__executeDestructive",
      "mcp__github__create_pull_request",
      "mcp__github__update_pull_request",
      "mcp__github__add_issue_comment",
      "mcp__github__update_issue_comment",
      "mcp__github__add_reply_to_pull_request_comment",
      "Bash(.claude/scripts/jira/*)",
      "Bash(.claude/scripts/github/create-release.sh*)",
      "mcp__atlassian__getAccessibleAtlassianResources",
      "mcp__atlassian__atlassianUserInfo",
      "mcp__atlassian__getJiraIssue",
      "mcp__atlassian__searchJiraIssuesUsingJql",
      "mcp__atlassian__executeRead",
      "mcp__atlassian__discover",
      "mcp__atlassian__search",
      "mcp__github__pull_request_read",
      "mcp__github__list_pull_requests",
      "mcp__github__search_pull_requests",
      "mcp__github__issue_read",
      "mcp__github__actions_list",
      "mcp__github__actions_get",
      "mcp__github__get_job_logs",
      "mcp__github__list_releases",
      "mcp__github__get_latest_release",
      "mcp__github__get_release_by_tag",
      "mcp__github__list_tags",
      "mcp__github__get_tag",
      "mcp__github__list_branches",
      "mcp__github__list_commits",
      "mcp__github__get_commit",
      "mcp__github__get_file_contents",
      "Bash(cargo:*)",
      "Bash(rustup:*)"
    ],
    "ask": []
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "enableAllProjectMcpServers": true,
  "includeCoAuthoredBy": false
}
